{
  "name": "@diptos/sdk",
  "version": "1.0.0",
  "description": "Programmable USDC escrow links, Time-Entropic Collateral Decay (TECD) math, Grok AI deliverable auditing, and Gemini Prediction Markets risk pricing SDK for Arc Testnet (Chain ID 5042002).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://diptos.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jayram2204/Diptos-Arc.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "diptos",
    "arc",
    "usdc",
    "escrow",
    "ai-agents",
    "web3",
    "viem",
    "tecd",
    "gemini-prediction-markets",
    "grok"
  ],
  "publishConfig": {
